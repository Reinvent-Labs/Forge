{
  "name": "@forge/database",
  "version": "1.0.0",
  "private": true,
  "description": "Forge database client and schema (Prisma + PostgreSQL)",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "db:generate": "prisma generate",
