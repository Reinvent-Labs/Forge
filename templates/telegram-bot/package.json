{
  "name": "forge-telegram-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram bot template — Forge-ready with grammY, PostgreSQL, and Redis session storage",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@grammyjs/storage-redis": "^2.0.0",
    "@prisma/client": "^5.22.0",
    "grammy": "^1.30.0",
    "ioredis": "^5.3.0",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
