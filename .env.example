# =============================================================================
# FORGE PLATFORM — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in all values before running.
# NEVER commit .env files with real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://forge:password@localhost:5432/forge"
REDIS_URL="redis://localhost:6379"

# -----------------------------------------------------------------------------
# AI MODELS
# -----------------------------------------------------------------------------
# Anthropic Claude — used for Builder, Fixer, Sonnet-tier agents
ANTHROPIC_API_KEY=

# OpenAI — optional Codex/GPT-4o fallback + embeddings
OPENAI_API_KEY=

# Claude Code SDK — for Builder/Fixer code execution (if separate)
CLAUDE_CODE_API_KEY=

# Default model overrides (defaults shown)
HAIKU_MODEL=claude-haiku-4-5-20251001
SONNET_MODEL=claude-sonnet-4-6
OPUS_MODEL=claude-opus-4-6
EMBEDDING_MODEL=text-embedding-3-small

# -----------------------------------------------------------------------------
# GITHUB APP
# -----------------------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=          # PEM content, newlines escaped as \n
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# AUTH (Better Auth)
# -----------------------------------------------------------------------------
BETTER_AUTH_SECRET=              # 32+ random chars
BETTER_AUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# AUTH (Dashboard / NextAuth)
# -----------------------------------------------------------------------------
# REQUIRED. Signs/encrypts dashboard session cookies. The dashboard refuses to
# start if this is unset or shorter than 32 characters.
# Next.js does not read this root file: also set it in apps/dashboard/.env.local.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# NOTIFICATIONS
# -----------------------------------------------------------------------------
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=                 # xoxb-...
SLACK_APP_TOKEN=                 # xapp-... (for Socket Mode)

TELEGRAM_BOT_TOKEN=

# -----------------------------------------------------------------------------
# STORAGE (S3-compatible)
# -----------------------------------------------------------------------------
S3_BUCKET=forge-artifacts
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=                     # e.g. https://s3.us-east-1.amazonaws.com or Cloudflare R2
S3_REGION=us-east-1

# -----------------------------------------------------------------------------
# SECRETS MANAGEMENT
# -----------------------------------------------------------------------------
# Option A: HashiCorp Vault
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=

# Option B: Doppler
DOPPLER_TOKEN=

# Which provider to use: 'vault' | 'doppler' | 'env' (for local dev)
SECRETS_PROVIDER=env

# Master encryption key for per-tenant credential encryption
MASTER_ENCRYPTION_KEY=          # 32-byte hex string

# -----------------------------------------------------------------------------
# SELF-MONITORING
# -----------------------------------------------------------------------------
SENTRY_DSN=
POSTHOG_KEY=
PROMETHEUS_PORT=9090

# -----------------------------------------------------------------------------
# DEPLOYMENT INTEGRATIONS (optional, per-project)
# -----------------------------------------------------------------------------
VERCEL_TOKEN=
RAILWAY_TOKEN=
RENDER_API_KEY=
FLY_API_TOKEN=

# -----------------------------------------------------------------------------
# MISC
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000                        # Orchestrator API port
DASHBOARD_URL=http://localhost:3000
LOG_LEVEL=debug                  # pino log level: trace|debug|info|warn|error|fatal
